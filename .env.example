# Supabase (database, owner login, product photos, enquiries).
# Supabase dashboard → Project Settings → API. See ADMIN-SETUP.md.
# Leave both empty to run in demo mode: the site uses the bundled starter
# catalogue and /admin saves changes only in this browser
# (login demo@ramlakhan.shop / demo1234).

# Project URL, e.g. https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=
# "anon public" key (safe to expose; never put the service_role key here)
VITE_SUPABASE_ANON_KEY=
